# Supabase — project "LivLyf"
# API (required for livlyf-api): Dashboard → Settings → API → service_role (JWT, NOT the database password)
SUPABASE_URL=https://hzaakdbgkuawheuvkdhh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt

# Direct Postgres (optional — psql, Supabase CLI, migrations). Dashboard → Settings → Database
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.hzaakdbgkuawheuvkdhh.supabase.co:5432/postgres

# Web (Vite loads from repo root via envDir)
VITE_SUPABASE_URL=https://hzaakdbgkuawheuvkdhh.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_API_URL=http://localhost:3001
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# API
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Azure OpenAI (GPT deployment — e.g. gpt-6-luna when you provide details)
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna

# Stripe pay-per-use
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PER_RUN_CENTS=99

# Admin emails (comma-separated) — usage is free
LIVLYF_ADMIN_EMAILS=you@example.com
